# Optional publisher key for fridge photos. Leave this blank to use the
# deterministic planner and visitor BYOK only. Never commit a real key.
XAI_API_KEY=

# Vision and chat model id. See https://docs.x.ai/developers/models
XAI_MODEL=grok-4.7

# OpenAI-compatible xAI API origin.
XAI_BASE_URL=https://api.x.ai/v1
